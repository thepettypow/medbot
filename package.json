{
  "name": "medbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
