# Telegram
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=        # random string, sent as secret_token on setWebhook
ADMIN_CHAT_IDS=111111111,222222222

# Cron protection (Vercel Cron sends this automatically as a Bearer token)
CRON_SECRET=

# Neon (use an EU region + the pooled connection string)
DATABASE_URL=

# Defaults (optional)
DEFAULT_TIMEZONE=Asia/Tehran
DUE_WINDOW_MIN=10              # a dose is sendable for this long after its time
STALE_AFTER_MIN=10             # older than the window => missed_system, never sent
MISSED_AFTER_MIN=120           # no answer after this => missed
NUDGE_OFFSETS_MIN=15,45        # re-nudges after the reminder; empty = off
SNOOZE_MIN=30
MAX_SNOOZES=2
