# Telegram
BOT_TOKEN=
# Comma-separated numeric Telegram IDs (get yours from @userinfobot)
ADMIN_CHAT_IDS=111111111,222222222

# Neon (EU region; pooled or direct connection string both work)
DATABASE_URL=

# Optional local health endpoint: GET http://127.0.0.1:$HEALTH_PORT/health (0 = off)
HEALTH_PORT=0

# Defaults (optional)
DEFAULT_TIMEZONE=Asia/Tehran
# a dose is sendable for this long after its time (covers a short restart)
DUE_WINDOW_MIN=10
# older than this => missed_system, never sent
STALE_AFTER_MIN=10
# no answer after this => missed
MISSED_AFTER_MIN=120
# re-nudges after the reminder; empty = off
NUDGE_OFFSETS_MIN=15,45
SNOOZE_MIN=30
MAX_SNOOZES=2
